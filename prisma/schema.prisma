generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  password           String
  role               Role      @default(WRITER)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  isVerified         Boolean   @default(false)
  resetToken         String?
  resetTokenExpiry   DateTime?
  verificationExpiry DateTime?
  verificationToken  String?   @unique
  blogs              Blog[]
}

model Blog {
  id            Int             @id @default(autoincrement())
  title         String
  slug          String          @unique
  excerpt       String?
  content       String
  status        Status          @default(DRAFT)
  authorId      Int
  categoryId    Int?
  publishedAt   DateTime?
  generatedAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  readTime      Int?
  trendingScore Float           @default(0)
  author        User            @relation(fields: [authorId], references: [id])
  category      Category?       @relation(fields: [categoryId], references: [id])
  tags          BlogTag[]
  views         BlogView[]
  faqs          BlogFAQ[]
  ChangeRequest ChangeRequest[]

  @@index([status])
  @@index([publishedAt])
  @@index([trendingScore(sort: Desc)])
}

model FAQ {
  id        Int      @id @default(autoincrement())
  question  String 
  answer    String
  createdAt DateTime @default(now())

  blogs BlogFAQ[]
}

model BlogFAQ {
  id     Int  @id @default(autoincrement())
  blogId Int
  faqId  Int
  blog   Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  faq    FAQ  @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@unique([blogId, faqId])
  @@index([blogId])
  @@index([faqId])
}

model Tag {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  slug      String          @unique
  createdAt DateTime        @default(now())
  status    CatAndTagStatus @default(APPROVED)
  blogs     BlogTag[]

  @@index([status])
}

model Category {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  slug      String          @unique
  createdAt DateTime        @default(now())
  status    CatAndTagStatus @default(PENDING)
  blogs     Blog[]

  @@index([status])
}

model BlogTag {
  blogId Int
  tagId  Int
  blog   Blog @relation(fields: [blogId], references: [id])
  tag    Tag  @relation(fields: [tagId], references: [id])

  @@id([blogId, tagId])
  @@index([blogId])
  @@index([tagId])
}

model BlogView {
  id        Int      @id @default(autoincrement())
  blogId    Int
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  blog      Blog     @relation(fields: [blogId], references: [id])

  @@index([blogId])
  @@index([createdAt])
}

model ChangeRequest {
  id        Int      @id @default(autoincrement())
  blogId    Int
  message   String
  adminId   Int
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  blog      Blog     @relation(fields: [blogId], references: [id])
}

enum Role {
  SUPERADMIN
  WRITER
}

enum Status {
  DRAFT
  REVIEW
  PUBLISHED
  CHANGES_REQUESTED
  TRASH
}

enum CatAndTagStatus {
  PENDING
  APPROVED
  ARCHIVED
}
